def cmd_bundle_import(args: argparse.Namespace) -> int:
    paths = _paths(args)
    bundle_path = Path(args.bundle)
    anchors_path = Path(args.anchors) if args.anchors else paths.anchors_path
    state_path = Path(args.state) if args.state else paths.state_path
    data_db_dir = Path(args.data_db_dir) if args.data_db_dir else paths.data_db_dir

    if args.fingerprint:
        digest = hashlib.sha256(bundle_path.read_bytes()).hexdigest()
        manifest = peek_manifest(bundle_path)
        print(f"bundle_version: {manifest['bundle_version']}")
        print(f"kind: {manifest['kind']}")
        print(f"base_version: {manifest.get('base_version')}")
        print(f"sha256: {digest}")
        return 0

    if not args.confirm:
        raise SystemExit("refusing to import without --confirm (use --fingerprint to preview first)")

    manifest = peek_manifest(bundle_path)
    with _writer_flock(paths.intel_lock_path):
        if manifest["kind"] == "full":
            result = import_full(bundle_path, anchors_path, state_path, data_db_dir)
        else:
            current = generations.current_generation(data_db_dir)
            if current is None:
                raise SystemExit("no live generation to apply a differential bundle against")
            live_path = generations.intel_db_path(data_db_dir, current)
            conn = _open_intel_connection(live_path)
            try:
                result = apply_differential(bundle_path, anchors_path, state_path, conn)
            finally:
                conn.close()

    print(f"imported bundle_version={result.bundle_version} generation={result.generation} tables={result.tables}")
    _audit_event(paths, "azctl", {"action": "bundle_import", "bundle_version": result.bundle_version})
    return 0


def cmd_bundle_resolve_state(args: argparse.Namespace) -> int:
    paths = _paths(args)
    state_path = Path(args.state) if args.state else paths.state_path
    state = read_state(state_path)
    print(f"last_imported_version: {state.last_imported_version}")
    print(f"last_import_at: {state.last_import_at}")
    print(f"last_bundle_sha256: {state.last_bundle_sha256}")
    print(f"needs_full_rebaseline: {state.needs_full_rebaseline}")

    if args.clear_rebaseline:
        if not args.confirm:
            raise SystemExit("refusing to clear needs_full_rebaseline without --confirm")
        mark_needs_full_rebaseline(state_path, False)
        print("needs_full_rebaseline cleared")
        _audit_event(paths, "azctl", {"action": "resolve_state", "clear_rebaseline": True})
    return 0


