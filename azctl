def cmd_bundle_build(args: argparse.Namespace) -> int:
    return bundle_build.main(["build", *args.bundle_build_args])


def cmd_bundle_sign(args: argparse.Namespace) -> int:
    bundle_path = Path(args.bundle)
    members: list[tuple[str, bytes]] = []
    with tarfile.open(bundle_path, "r:gz") as tar:
        for info in tar.getmembers():
            data = tar.extractfile(info).read() if info.isreg() else b""
            members.append((info.name, data))

    manifest_bytes: bytes | None = None
    sig_bytes = b""
    content_members: list[tuple[str, bytes]] = []
    for name, data in members:
        if name == bundle_build.MANIFEST_MEMBER:
            manifest_bytes = data
        elif name == bundle_build.SIGNATURE_MEMBER:
            sig_bytes = data
        else:
            content_members.append((name, data))

    if manifest_bytes is None:
        raise SystemExit(f"{bundle_path}: no manifest.json member found")

    sig_lines = [ln for ln in sig_bytes.decode("utf-8").splitlines() if ln.strip()]
    for key_path in args.sign_key:
        hex_key = Path(key_path).read_text(encoding="utf-8").strip()
        signing_key = SigningKey(bytes.fromhex(hex_key))
        key_id = signing_key.verify_key.encode().hex()[:8]
        signature = signing_key.sign(manifest_bytes).signature.hex()
        sig_lines.append(f"{key_id}:{signature}")
    new_sig_bytes = ("\n".join(sig_lines) + "\n").encode("utf-8")

    tmp_out = bundle_path.with_name(f".{bundle_path.name}.tmp")
    with tarfile.open(tmp_out, "w:gz") as tar:
        _add_tar_bytes(tar, bundle_build.MANIFEST_MEMBER, manifest_bytes)
        _add_tar_bytes(tar, bundle_build.SIGNATURE_MEMBER, new_sig_bytes)
        for name, data in content_members:
            _add_tar_bytes(tar, name, data)
    os.replace(tmp_out, bundle_path)

    print(f"added {len(args.sign_key)} signature(s) to {bundle_path} ({len(sig_lines)} total)")
    return 0


def cmd_bundle_inspect(args: argparse.Namespace) -> int:
    manifest = peek_manifest(args.bundle)
    print(json.dumps(manifest, indent=2, sort_keys=True))
