def cmd_backup(args: argparse.Namespace) -> int:
    paths = _paths(args)
    out_dir = Path(args.out_dir)
    out_dir.mkdir(parents=True, exist_ok=True)
    intel_db_path = current_intel_db_path(paths.data_db_dir)

    with _writer_flock(paths.local_lock_path), _writer_flock(paths.intel_lock_path):
        local_out = out_dir / "local.db"
        intel_out = out_dir / "intel.db"
        for existing in (local_out, intel_out):
            if existing.exists():
                existing.unlink()

        conn = sqlite3.connect(paths.local_db_path)
        try:
            conn.execute("VACUUM INTO ?", (str(local_out),))
        finally:
            conn.close()

        conn = sqlite3.connect(intel_db_path)
        try:
            conn.execute("VACUUM INTO ?", (str(intel_out),))
        finally:
            conn.close()

    print(f"backup written: {local_out}, {intel_out}")
    return 0


def cmd_restore(args: argparse.Namespace) -> int:
    paths = _paths(args)
    backup_dir = Path(args.backup_dir)
    local_backup = backup_dir / "local.db"
    intel_backup = backup_dir / "intel.db"
    if not local_backup.is_file() or not intel_backup.is_file():
        raise SystemExit(f"expected local.db and intel.db under {backup_dir}")
    if not args.confirm:
        raise SystemExit("refusing to restore without --confirm (this replaces the live databases)")

    paths.ensure_dirs()
    with _writer_flock(paths.local_lock_path), _writer_flock(paths.intel_lock_path):
        import shutil

        shutil.copy2(local_backup, paths.local_db_path)

        current = generations.current_generation(paths.data_db_dir)
        next_n = 1 if current is None else current + 1
        new_gen_dir = generations.generation_dir(paths.data_db_dir, next_n)
        new_gen_dir.mkdir(parents=True, exist_ok=True)
        shutil.copy2(intel_backup, generations.intel_db_path(paths.data_db_dir, next_n))
        generations.swap_current(paths.data_db_dir, next_n)
        generations.gc_old_generations(paths.data_db_dir, keep=2)

    mark_needs_full_rebaseline(paths.state_path, True)
    _audit_event(paths, "azctl", {"action": "restore", "generation": next_n})
    print(f"restored local.db and intel.db (generation {next_n}); needs_full_rebaseline=true")
    return 0


# --------------------------------------------------------------------------
# audit verify
# --------------------------------------------------------------------------


def cmd_audit_verify(args: argparse.Namespace) -> int:
    paths = _paths(args)
    chains_dir = paths.audit_dir
    anchor_path = chains_dir / "anchor.jsonl"
    ok = True

    if not chains_dir.is_dir():
        print(f"no audit chains found under {chains_dir}")
        return 0

    for path in sorted(chains_dir.rglob("*.jsonl")):
        if path == anchor_path:
            continue
        result = verify_chain(path)
        status = "OK" if result.ok else f"FAIL ({result.error} at seq {result.bad_seq})"
        print(f"chain {path.relative_to(chains_dir)}: {status} ({result.lines} lines)")
        ok = ok and result.ok

    if paths.node_signing_key_path.is_file():
        verify_key = SigningKey(paths.node_signing_key_path.read_bytes()).verify_key
        anchors_ok = verify_anchors(anchor_path, chains_dir, verify_key)
        print(f"anchors: {'OK' if anchors_ok else 'FAIL'}")
        ok = ok and anchors_ok
    else:
        print("anchors: skipped (no node_signing_key found)")

    print(f"audit verify: {'PASS' if ok else 'FAIL'}")
    return 0 if ok else 1


