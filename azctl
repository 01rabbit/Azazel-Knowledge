def cmd_feed_pull(args: argparse.Namespace) -> int:
    paths = _paths(args)
    paths.ensure_dirs()
    ensure_local_db(paths.local_db_path)
    intel_db_path = current_intel_db_path(paths.data_db_dir)
    config_loader = TrackedConfigLoader(paths.config_dir)
    feeds_doc = config_loader.feeds()
    exclusion_policy = load_exclusion_policy(paths.config_dir)

    if args.file:
        file_path = Path(args.file)
        fetch_bytes = file_path.read_bytes
    elif args.online:
        from azazel_knowledge.feeds.base import fetch_https_with_pins
        from azazel_knowledge.worker import FEED_ENDPOINTS

        url = FEED_ENDPOINTS.get(args.feed_id)
        if url is None:
            raise SystemExit(f"no known online endpoint for feed {args.feed_id!r}; use --file")
        merged = feeds_doc.get("feeds", {}).get(args.feed_id, {})
        pins = list(merged.get("pin_spki_sha256") or [])
        fetch_bytes = lambda: fetch_https_with_pins(url, pins)  # noqa: E731
    else:
        raise SystemExit("azctl feed pull requires --file PATH (offline) or --online")

    from azazel_knowledge.core.clock import SystemClock

    local_writer = PrioritySingleWriterQueue(paths.local_db_path, paths.local_lock_path)
    intel_writer = PrioritySingleWriterQueue(intel_db_path, paths.intel_lock_path)
    try:
        local_writer.open()
        intel_writer.open()
    except WriterLockHeld as exc:
        raise SystemExit(f"writer lock held (is the worker running?): {exc}") from exc
    try:
        adapter = build_feed_adapter(
            args.feed_id, feeds_doc, intel_writer, local_writer,
            clock=SystemClock(), fetch_bytes=fetch_bytes, exclusion_policy=exclusion_policy,
        )
        outcome = adapter.run()
    finally:
        local_writer.close()
        intel_writer.close()

    print(
        f"feed_id={outcome.feed_id} status={outcome.status} "
        f"items_fetched={outcome.items_fetched} items_applied={outcome.items_applied} "
        f"reason={outcome.reason}"
    )
    return 0 if outcome.status in ("applied", "throttled", "warming_up") else 1


def cmd_feed_inspect(args: argparse.Namespace) -> int:
    paths = _paths(args)
    intel_db_path = current_intel_db_path(paths.data_db_dir)
    conn = sqlite3.connect(f"file:{intel_db_path}?mode=ro", uri=True)
    conn.row_factory = sqlite3.Row
    try:
        state = conn.execute("SELECT * FROM feed_state WHERE feed_id = ?", (args.feed_id,)).fetchone()
    finally:
        conn.close()
    print(f"feed_state: {dict(state) if state else None}")

    local_conn = sqlite3.connect(f"file:{paths.local_db_path}?mode=ro", uri=True)
    local_conn.row_factory = sqlite3.Row
    try:
        rows = local_conn.execute(
            "SELECT * FROM feed_quarantine WHERE feed_id = ? ORDER BY quarantined_at DESC", (args.feed_id,)
        ).fetchall()
    finally:
        local_conn.close()
    print(f"feed_quarantine ({len(rows)}):")
    for row in rows:
        print(f"  {dict(row)}")
    return 0


def cmd_feed_approve(args: argparse.Namespace) -> int:
    paths = _paths(args)
    intel_db_path = current_intel_db_path(paths.data_db_dir)

    with _writer_flock(paths.intel_lock_path):
        conn = _open_intel_connection(intel_db_path)
        try:
            conn.execute("BEGIN IMMEDIATE")
            conn.execute("UPDATE feed_state SET enabled = 1 WHERE feed_id = ?", (args.feed_id,))
            conn.execute("COMMIT")
        finally:
            conn.close()

    from azazel_knowledge.db.repository import utc_now_rfc3339

    with _writer_flock(paths.local_lock_path):
        local_conn = sqlite3.connect(paths.local_db_path, isolation_level=None)
        try:
            local_conn.execute("BEGIN IMMEDIATE")
            local_conn.execute(
                "UPDATE feed_quarantine SET resolved_at = ? "
                "WHERE feed_id = ? AND resolved_at IS NULL",
                (utc_now_rfc3339(), args.feed_id),
            )
            local_conn.execute("COMMIT")
        finally:
            local_conn.close()

    _audit_event(paths, "azctl", {"action": "feed_approve", "feed_id": args.feed_id})
    print(f"feed {args.feed_id!r} re-enabled and open quarantine entries resolved")
    return 0


