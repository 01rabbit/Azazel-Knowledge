def cmd_client_add(args: argparse.Namespace) -> int:
    paths = _paths(args)
    ensure_local_db(paths.local_db_path)
    key_id = args.key_id or os.urandom(4).hex()
    scopes = [s.strip() for s in args.scopes.split(",") if s.strip()]
    token, token_sha256 = auth.mint_token(key_id)

    from azazel_knowledge.db.repository import utc_now_rfc3339

    def _insert(conn: sqlite3.Connection) -> None:
        conn.execute(
            "INSERT INTO api_client (key_id, token_sha256, scopes, quota_bytes, enabled, created_at) "
            "VALUES (?, ?, ?, ?, 1, ?)",
            (key_id, token_sha256, json.dumps(scopes), args.quota_bytes, utc_now_rfc3339()),
        )

    writer = PrioritySingleWriterQueue(paths.local_db_path, paths.local_lock_path)
    writer.open()
    try:
        writer.submit(P0, _insert)
        writer.process_pending()
    finally:
        writer.close()

    print(f"key_id: {key_id}")
    print(f"scopes: {scopes}")
    print(f"token (shown once): {token}")
    return 0


def cmd_client_list(args: argparse.Namespace) -> int:
    paths = _paths(args)
    conn = sqlite3.connect(f"file:{paths.local_db_path}?mode=ro", uri=True)
    conn.row_factory = sqlite3.Row
    try:
        rows = conn.execute("SELECT key_id, scopes, quota_bytes, enabled, created_at FROM api_client").fetchall()
    finally:
        conn.close()
    for row in rows:
        print(dict(row))
    return 0


def cmd_client_revoke(args: argparse.Namespace) -> int:
    paths = _paths(args)

    def _revoke(conn: sqlite3.Connection) -> None:
        conn.execute("UPDATE api_client SET enabled = 0 WHERE key_id = ?", (args.key_id,))

    writer = PrioritySingleWriterQueue(paths.local_db_path, paths.local_lock_path)
    writer.open()
    try:
        writer.submit(P0, _revoke)
        writer.process_pending()
    finally:
        writer.close()
    _audit_event(paths, "azctl", {"action": "client_revoke", "key_id": args.key_id})
    print(f"client {args.key_id!r} revoked")
    return 0


