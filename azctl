def _behavior_mode(mode: str) -> str:
    if mode not in {"incremental", "rebuild"}:
        raise SystemExit(f"unsupported behavior mode: {mode}")
    return mode


def cmd_behavior_generate(args: argparse.Namespace) -> int:
    from azazel_knowledge.core.clock import SystemClock

    paths = _paths(args)
    paths.ensure_dirs()
    ensure_local_db(paths.local_db_path)
    loader = TrackedConfigLoader(paths.config_dir)
    writer = PrioritySingleWriterQueue(paths.local_db_path, paths.local_lock_path)
    try:
        writer.open()
    except WriterLockHeld as exc:
        raise SystemExit(f"writer lock held (is the worker running?): {exc}") from exc
    result: dict[str, Any] = {}
    try:
        def _txn(conn: sqlite3.Connection) -> None:
            plan = apply_generation_plan(
                conn,
                loader,
                query_as_of=SystemClock().query_as_of(),
                mode=_behavior_mode(args.behavior_mode),
            )
            result["generation"] = plan.behavior_generation
            result["patterns"] = len(plan.patterns)
            result["carried_forward"] = plan.carried_forward

        writer.submit(P0, _txn)
        writer.process_pending()
    finally:
        writer.close()
    print(
        f"behavior_generation={result.get('generation')} "
        f"patterns_written={result.get('patterns', 0)} "
        f"carried_forward={result.get('carried_forward', 0)}"
    )
    return 0


def cmd_behavior_dry_run(args: argparse.Namespace) -> int:
