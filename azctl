def _paths(args: argparse.Namespace) -> WorkerPaths:
    root = Path(args.root) if getattr(args, "root", None) else Path(os.environ.get("AZAZEL_ROOT", ".")).resolve()
    config_dir = Path(args.config_dir) if getattr(args, "config_dir", None) else None
    return WorkerPaths.from_root(root, config_dir=config_dir)


@contextlib.contextmanager
def _writer_flock(lock_path: Path):
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    fh = open(lock_path, "w")
    try:
        fcntl.flock(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError as exc:
        fh.close()
        raise SystemExit(f"writer lock held (is the worker running?): {lock_path} ({exc})") from exc
    try:
        yield
    finally:
        fcntl.flock(fh.fileno(), fcntl.LOCK_UN)
        fh.close()


def _open_intel_connection(intel_path: Path) -> sqlite3.Connection:
    conn = sqlite3.connect(intel_path, isolation_level=None)
    for pragma in WRITER_PRAGMAS:
        conn.execute(pragma)
    return conn


def _add_tar_bytes(tar: tarfile.TarFile, name: str, data: bytes) -> None:
    info = tarfile.TarInfo(name=name)
    info.size = len(data)
    info.mtime = 0
    info.mode = 0o644
    tar.addfile(info, io.BytesIO(data))


def _audit_event(paths: WorkerPaths, stream: str, event: dict[str, Any]) -> None:
    """Append one line to an azctl audit chain and roll a joint anchor if due.

    Best-effort: a broken audit sink must not block an operator CLI
    command from completing (unlike the API's context path, which fails
    closed per F-17), so failures here are printed, not raised.
    """
    from azazel_knowledge.audit.logger import AuditChain

    try:
        chain_dir = paths.audit_dir / stream
        chain = AuditChain(chain_dir, f"azctl-{os.getpid()}", "cli", lambda text: text)
        chain.append(event)
        chain.flush()
        if paths.node_signing_key_path.is_file():
            signing_key = SigningKey(paths.node_signing_key_path.read_bytes())
            anchor_mgr = MerkleAnchor(paths.audit_dir, paths.audit_dir / "anchor.jsonl", signing_key)
            anchor_mgr.record_entries(1)
            anchor_mgr.maybe_anchor()
    except Exception as exc:  # noqa: BLE001
        print(f"warning: audit event not recorded: {exc}", file=sys.stderr)


