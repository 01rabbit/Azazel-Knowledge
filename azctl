def cmd_health(args: argparse.Namespace) -> int:
    paths = _paths(args)
    snapshot: dict[str, Any] = {}

    intel_db_path = current_intel_db_path(paths.data_db_dir)
    conn = sqlite3.connect(f"file:{intel_db_path}?mode=ro", uri=True)
    conn.row_factory = sqlite3.Row
    try:
        snapshot["feeds"] = [dict(r) for r in conn.execute(
            "SELECT feed_id, last_run, last_success, enabled FROM feed_state"
        ).fetchall()]
        snapshot["intel_generation"] = generations.current_generation(paths.data_db_dir)
    finally:
        conn.close()

    if paths.local_db_path.is_file():
        local_conn = sqlite3.connect(f"file:{paths.local_db_path}?mode=ro", uri=True)
        local_conn.row_factory = sqlite3.Row
        try:
            snapshot["open_quarantine"] = local_conn.execute(
                "SELECT COUNT(*) AS n FROM feed_quarantine WHERE resolved_at IS NULL"
            ).fetchone()["n"]
            snapshot["pending_edge_reported"] = local_conn.execute(
                "SELECT COUNT(*) AS n FROM edge_reported_ioc WHERE status = 'quarantined'"
            ).fetchone()["n"]
        finally:
            local_conn.close()
    else:
        snapshot["open_quarantine"] = None
        snapshot["pending_edge_reported"] = None

    state = read_state(paths.state_path) if paths.state_path.is_file() else None
    snapshot["bundle_state"] = {
        "last_imported_version": state.last_imported_version if state else None,
        "needs_full_rebaseline": state.needs_full_rebaseline if state else None,
    }

    print(json.dumps(snapshot, indent=2, sort_keys=True))
    return 0


# --------------------------------------------------------------------------
# scrub
# --------------------------------------------------------------------------


def cmd_scrub(args: argparse.Namespace) -> int:
    if args.force:
        raise SystemExit(
            "azctl scrub --force is not implemented in Phase 1: crypto-erase is a hardware/LUKS "
            "operation (destroy the LUKS header key slots), not something this dev CLI performs."
        )
    print(
        "azctl scrub is a documented stub (design S7). The real crypto-erase procedure is:\n"
        "  1. Stop the api and worker containers.\n"
        "  2. cryptsetup luksErase <secrets-partition-device>\n"
        "     cryptsetup luksErase <data-partition-device>\n"
        "     (each destroys every LUKS2 key slot; without a slot the Adiantum-encrypted\n"
        "     ciphertext on disk is unrecoverable -- this is the seizure-model crypto-erase.)\n"
        "  3. Physically wipe or destroy secrets/node_signing_key and secrets/trust/*.toml if the\n"
        "     device is being decommissioned rather than re-keyed.\n"
        "No destructive action is taken without --force, and --force always errors in Phase 1 dev."
    )
    return 0


