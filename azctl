#: Consumer policy fields `azctl keys` does not edit but must carry across a
#: rewrite: dropping `required_signer_role` would silently widen who may sign.
_ANCHOR_POLICY_FIELDS = ("required_signer_role", "minimum_security_epoch", "accepted_export_policy_digests")


def _dump_anchors(
    threshold: int,
    keys: dict[str, str],
    revoked: list[str],
    policy: dict[str, Any] | None = None,
) -> str:
    policy = policy or {}
    lines = [f"threshold = {json.dumps(threshold)}", f"revoked = [{', '.join(json.dumps(r) for r in revoked)}]"]
    if "sealed" in policy and policy["sealed"] is not False:
        lines.append(f"sealed = {json.dumps(policy['sealed'])}")
    for name in _ANCHOR_POLICY_FIELDS:
        if name in policy:
            lines.append(f"{name} = {json.dumps(policy[name])}")
    lines.append("")
    lines.append("[keys]")
    for key_id, hex_key in keys.items():
        lines.append(f"{key_id} = {json.dumps(hex_key)}")
    if policy.get("key_roles"):
        lines.append("")
        lines.append("[key_roles]")
        for key_id, role in policy["key_roles"].items():
            lines.append(f"{json.dumps(key_id)} = {json.dumps(role)}")
    return "\n".join(lines) + "\n"


def cmd_provision(args: argparse.Namespace) -> int:
    paths = _paths(args)
    paths.ensure_dirs()

    ensure_local_db(paths.local_db_path)
    gen = ensure_intel_generation(paths.data_db_dir)
    print(f"initialized data/db/local.db and data/db/gen-{gen}/intel.db (current)")

    if not paths.node_signing_key_path.is_file():
        signing_key = SigningKey.generate()
        paths.node_signing_key_path.write_bytes(signing_key.encode())
        paths.node_signing_key_path.chmod(0o600)
        print(f"generated node signing key: {paths.node_signing_key_path}")
        print(f"node verify_key: {signing_key.verify_key.encode().hex()}")
    else:
        print(f"node signing key already present: {paths.node_signing_key_path}")

    if _provision_anchors(paths):
        print(f"wrote trust anchor template: {paths.anchors_path} (empty -- run 'azctl keys add')")
    else:
        print(f"trust anchors already present: {paths.anchors_path}")

    if not paths.state_path.is_file():
        from azazel_knowledge.bundle.rollback_anchor import RollbackState, write_state

        write_state(paths.state_path, RollbackState())
        print(f"wrote anti-rollback state: {paths.state_path}")
    else:
        print(f"anti-rollback state already present: {paths.state_path}")

    key_id = os.urandom(4).hex()
    token, token_sha256 = auth.mint_token(key_id)
    scopes = ["ingest", "query", "read", "admin"]

    def _insert_admin(conn: sqlite3.Connection) -> None:
        from azazel_knowledge.db.repository import utc_now_rfc3339

        conn.execute(
            "INSERT INTO api_client (key_id, token_sha256, scopes, quota_bytes, enabled, created_at) "
            "VALUES (?, ?, ?, NULL, 1, ?)",
            (key_id, token_sha256, json.dumps(scopes), utc_now_rfc3339()),
        )

    writer = PrioritySingleWriterQueue(paths.local_db_path, paths.local_lock_path)
    writer.open()
    try:
        writer.submit(P0, _insert_admin)
        writer.process_pending()
    finally:
        writer.close()

    print("")
    print("first admin API client token (shown once -- store it now):")
    print(f"  key_id: {key_id}")
    print(f"  token:  {token}")
    print("")

    if args.check_thermal:
        thermal_path = Path("/sys/class/thermal/thermal_zone0/temp")
        if thermal_path.is_file():
            try:
                millidegrees = int(thermal_path.read_text().strip())
                print(f"thermal check: {millidegrees / 1000:.1f} C ({thermal_path})")
            except ValueError:
                print(f"thermal check: could not parse {thermal_path}")
        else:
            print("thermal check: skipped (no thermal zone found)")

    return 0


