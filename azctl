def cmd_behavior_report(args: argparse.Namespace) -> int:
    from azazel_knowledge.core.clock import SystemClock
    from azazel_knowledge.db.repository import Repository

    paths = _paths(args)
    ensure_local_db(paths.local_db_path)
    repo = Repository(paths.local_db_path, paths.data_db_dir)
    query_as_of = SystemClock().query_as_of()
    if args.report_format == "summary":
        payload = get_behavior_patterns_summary(
            repo,
            query_as_of=query_as_of,
            behavior_class=args.behavior_class,
            edge_id=args.edge_id,
            window_hours=args.window_hours,
            limit=args.limit,
        )
    else:
        payload = build_friction_timeline_report(
            repo,
            query_as_of=query_as_of,
            pattern_id=args.pattern_id,
            actor_key=args.actor_key,
            edge_id=args.edge_id,
        )

    rendered = json.dumps(payload, indent=2, sort_keys=True)
    if args.output is not None:
        Path(args.output).write_text(rendered + "\n", encoding="utf-8")
    else:
        print(rendered)
    return 0


# --------------------------------------------------------------------------
# keys list|add|remove|set-role|set-threshold|unseal
# --------------------------------------------------------------------------
#
# Every writer holds the anchors lock exclusively from read to write, so two
# commands cannot interleave and write back a document read before the other
# finished (a lost revocation). Imports hold the same lock shared.
#
# Audit: a change that can widen what this node accepts (adding a key, giving
# a role, lowering the threshold, unsealing) first records a durable (fsynced)
# `intent` event and is refused, anchors unchanged, if that record cannot be
# written; `done` or `aborted` with the same `op_id` follows. A change that
# only narrows acceptance (removing or revoking a key, sealing, clearing a
# role, raising the threshold) is never blocked by a broken audit sink, so an
# emergency revocation always goes through; its record is best-effort.


def _provision_anchors(paths: WorkerPaths) -> bool:
    """Write the empty template only if nothing is there, deciding under the writer lock."""
    paths.anchors_path.parent.mkdir(parents=True, exist_ok=True)
    with anchors_lock(paths.anchors_path, shared=False) as lock:
        if os.path.lexists(paths.anchors_path):
            return False
        write_anchors_atomic(lock, _dump_anchors(1, {}, []))
        return True


def _load_anchor_doc(anchors_path: Path) -> dict[str, Any]:
    import tomllib

    try:
        raw = read_anchors_bytes(anchors_path)
    except FileNotFoundError:
        return {"threshold": 1, "revoked": [], "keys": {}}
    except AnchorsStoreError as exc:
        raise SystemExit(f"refusing to use {anchors_path}: {exc}") from None
    return tomllib.loads(raw.decode("utf-8"))


def _anchor_text(doc: dict[str, Any]) -> str:
    policy = {name: doc[name] for name in (*_ANCHOR_POLICY_FIELDS, "key_roles", "sealed") if name in doc}
    return _dump_anchors(
        doc.get("threshold", 1), dict(doc.get("keys", {})), list(doc.get("revoked", [])), policy
    )


def _check_anchor_doc(doc: dict[str, Any]) -> str:
    """Render and validate; a sealed document need not be satisfiable, since nothing imports under it."""
    import tomllib

    text = _anchor_text(doc)
    parsed = tomllib.loads(text)
    validate_anchor_document(parsed, require_satisfiable=parsed.get("sealed") is not True)
    return text


def _audit_intent(paths: WorkerPaths, event: dict[str, Any]) -> str:
    """Durably record the intent of a trust-widening change, or refuse the change."""
    from azazel_knowledge.audit.logger import AuditChain, AuditUnavailable

    op_id = secrets.token_hex(8)
    try:
        chain = AuditChain(paths.audit_dir / "azctl", f"azctl-{os.getpid()}", "cli", lambda text: text)
        try:
            chain.append({**event, "phase": "intent", "op_id": op_id})
            chain.flush()
        finally:
            chain.close()
    except (AuditUnavailable, OSError) as exc:
        raise SystemExit(
            f"refusing to change {paths.anchors_path}: the audit intent could not be recorded "
            f"durably ({exc}); anchors unchanged"
        ) from None
    return op_id


def _save_anchor_doc(
    lock: AnchorsLock,
    paths: WorkerPaths,
    doc: dict[str, Any],
    event: dict[str, Any],
    *,
    widening: bool,
) -> None:
    try:
        text = _check_anchor_doc(doc)
    except BundleVerifyError as exc:
        raise SystemExit(f"refusing to write {lock.anchors_path}: {exc}") from None
    except ValueError as exc:
        raise SystemExit(f"refusing to write {lock.anchors_path}: BUNDLE_ANCHORS_INVALID: {exc}") from None
    op_id = _audit_intent(paths, event) if widening else None
    try:
        write_anchors_atomic(lock, text)
    except BaseException as exc:
        _audit_event(paths, "azctl", {**event, "phase": "aborted", "op_id": op_id, "error": str(exc)})
        if isinstance(exc, AnchorsStoreError):
            raise SystemExit(f"refusing to write {lock.anchors_path}: {exc}") from None
        raise
    _audit_event(paths, "azctl", {**event, "phase": "done", "op_id": op_id})


@contextlib.contextmanager
def _anchors_exclusive(paths: WorkerPaths):
    paths.anchors_path.parent.mkdir(parents=True, exist_ok=True)
    with anchors_lock(paths.anchors_path, shared=False) as lock:
        yield lock


def cmd_keys_list(args: argparse.Namespace) -> int:
    paths = _paths(args)
    paths.anchors_path.parent.mkdir(parents=True, exist_ok=True)
    with anchors_lock(paths.anchors_path, shared=True):
        doc = _load_anchor_doc(paths.anchors_path)
    keys = dict(doc.get("keys", {}))
    print(f"threshold: {doc.get('threshold', 1)}")
    print(f"keys ({len(keys)}):")
    for key_id, hex_key in keys.items():
        print(f"  {key_id}: {hex_key}")
    print(f"revoked: {list(doc.get('revoked', []))}")
    if doc.get("required_signer_role") is not None:
        print(f"required_signer_role: {doc['required_signer_role']}")
    for key_id, role in dict(doc.get("key_roles", {})).items():
        print(f"role {key_id}: {role}")
    if doc.get("sealed") is True:
        print("sealed: true (every import is refused; register a key, then 'azctl keys unseal')")
    return 0


def cmd_keys_add(args: argparse.Namespace) -> int:
    paths = _paths(args)
    with _anchors_exclusive(paths) as lock:
        doc = _load_anchor_doc(paths.anchors_path)
        doc.setdefault("keys", {})[args.key_id] = args.verify_key_hex
        if args.role is not None:
            doc.setdefault("key_roles", {})[args.key_id] = args.role
        event = {"action": "keys_add", "key_id": args.key_id, "verify_key": args.verify_key_hex, "role": args.role}
        _save_anchor_doc(lock, paths, doc, event, widening=True)
    print(f"added key {args.key_id!r}" + (f" with role {args.role!r}" if args.role is not None else ""))
    return 0


def cmd_keys_set_role(args: argparse.Namespace) -> int:
    paths = _paths(args)
    with _anchors_exclusive(paths) as lock:
        doc = _load_anchor_doc(paths.anchors_path)
        if args.key_id not in dict(doc.get("keys", {})):
            raise SystemExit(f"unknown key {args.key_id!r}; add it first with 'azctl keys add'")
        roles = doc.setdefault("key_roles", {})
        previous = roles.get(args.key_id)
        if args.clear:
            roles.pop(args.key_id, None)
        else:
            roles[args.key_id] = args.role
        event = {
            "action": "keys_set_role", "key_id": args.key_id,
            "previous_role": previous, "role": None if args.clear else args.role,
        }
        _save_anchor_doc(lock, paths, doc, event, widening=not args.clear)
    print(f"key {args.key_id!r} " + ("has no role" if args.clear else f"has role {args.role!r}"))
    return 0


def cmd_keys_remove(args: argparse.Namespace) -> int:
    """Removal is never refused for leaving too few keys: it seals the anchors instead.

    Refusing would keep a compromised key trusted. A sealed anchor admits no
    bundle at all, which is narrower than any threshold.
    """
    paths = _paths(args)
    sealed_now = False
    with _anchors_exclusive(paths) as lock:
        doc = _load_anchor_doc(paths.anchors_path)
        doc.setdefault("keys", {}).pop(args.key_id, None)
        if "key_roles" in doc:
            doc["key_roles"].pop(args.key_id, None)
        revoked = doc.setdefault("revoked", [])
        if args.revoke and args.key_id not in revoked:
            revoked.append(args.key_id)
        if doc.get("sealed") is not True:
            try:
                _check_anchor_doc(doc)
            except BundleVerifyError as exc:
                if exc.code != "BUNDLE_ANCHORS_THRESHOLD_INVALID":
                    raise SystemExit(f"refusing to write {paths.anchors_path}: {exc}") from None
                doc["sealed"] = True
                sealed_now = True
        event = {"action": "keys_remove", "key_id": args.key_id, "revoked": args.revoke, "sealed": sealed_now}
        _save_anchor_doc(lock, paths, doc, event, widening=False)
    print(f"removed key {args.key_id!r}" + (" (revoked)" if args.revoke else ""))
    if sealed_now:
        print(
            "anchors SEALED: no eligible key set remains, so every import is refused "
            "(BUNDLE_ANCHORS_SEALED). Register a key ('azctl keys add --role ...'), then "
            "'azctl keys unseal'.",
            file=sys.stderr,
        )
    return 0


def cmd_keys_set_threshold(args: argparse.Namespace) -> int:
    paths = _paths(args)
    with _anchors_exclusive(paths) as lock:
        doc = _load_anchor_doc(paths.anchors_path)
        previous = doc.get("threshold", 1)
        doc["threshold"] = args.threshold
        raising = isinstance(previous, int) and not isinstance(previous, bool) and args.threshold >= previous
        event = {"action": "keys_set_threshold", "previous_threshold": previous, "threshold": args.threshold}
        _save_anchor_doc(lock, paths, doc, event, widening=not raising)
    print(f"threshold set to {args.threshold}")
    return 0


def cmd_keys_unseal(args: argparse.Namespace) -> int:
    paths = _paths(args)
    with _anchors_exclusive(paths) as lock:
        doc = _load_anchor_doc(paths.anchors_path)
        if doc.get("sealed") is not True:
            raise SystemExit("anchors are not sealed")
        doc.pop("sealed")
        _save_anchor_doc(lock, paths, doc, {"action": "keys_unseal"}, widening=True)
    print("anchors unsealed")
    return 0


