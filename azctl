def _add_root_args(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--root", default=None, help="node root (default: $AZAZEL_ROOT or cwd)")
    parser.add_argument("--config-dir", default=None, help="config directory (default: <root>/config)")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="azctl", description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("provision", help="initialize a node's directory tree")
    _add_root_args(p)
    p.add_argument("--check-thermal", action="store_true")
    p.set_defaults(func=cmd_provision)

    p = sub.add_parser("check-config", help="validate config and print memory arithmetic")
    p.add_argument("--config-dir", default=None)
    p.set_defaults(func=cmd_check_config)

    bundle = sub.add_parser("bundle", help="bundle build|sign|inspect|import|resolve-state")
    bundle_sub = bundle.add_subparsers(dest="bundle_command", required=True)

    p = bundle_sub.add_parser("build", help="passthrough to tools/bundle_build.py build")
    p.add_argument("bundle_build_args", nargs=argparse.REMAINDER)
    p.set_defaults(func=cmd_bundle_build)

    p = bundle_sub.add_parser("sign", help="append signature(s) to an already-built bundle")
    p.add_argument("bundle")
    p.add_argument("--sign-key", action="append", required=True, dest="sign_key")
    p.set_defaults(func=cmd_bundle_sign)

    p = bundle_sub.add_parser("inspect", help="print a bundle's manifest, unverified")
    p.add_argument("bundle")
    p.set_defaults(func=cmd_bundle_inspect)

    p = bundle_sub.add_parser("import", help="verify and import a bundle")
    _add_root_args(p)
    p.add_argument("bundle")
    p.add_argument("--anchors", default=None)
    p.add_argument("--state", default=None)
    p.add_argument("--data-db-dir", default=None)
    p.add_argument("--confirm", action="store_true")
    p.add_argument("--fingerprint", action="store_true", help="print manifest_version/sha256 and exit")
    p.set_defaults(func=cmd_bundle_import)

    p = bundle_sub.add_parser("resolve-state", help="inspect/ack anti-rollback state after an alert")
    _add_root_args(p)
    p.add_argument("--state", default=None)
    p.add_argument("--clear-rebaseline", action="store_true")
    p.add_argument("--confirm", action="store_true")
    p.set_defaults(func=cmd_bundle_resolve_state)

    feed = sub.add_parser("feed", help="feed pull|inspect|approve")
    feed_sub = feed.add_subparsers(dest="feed_command", required=True)

    p = feed_sub.add_parser("pull", help="run one feed adapter cycle")
    _add_root_args(p)
    p.add_argument("feed_id")
    p.add_argument("--file", default=None, help="offline source file (air-gapped pull)")
    p.add_argument("--online", action="store_true", help="fetch live over the network")
    p.set_defaults(func=cmd_feed_pull)

    p = feed_sub.add_parser("inspect", help="print feed_state + feed_quarantine for a feed")
    _add_root_args(p)
    p.add_argument("feed_id")
    p.set_defaults(func=cmd_feed_inspect)

    p = feed_sub.add_parser("approve", help="re-enable a halted/quarantined feed")
    _add_root_args(p)
    p.add_argument("feed_id")
    p.set_defaults(func=cmd_feed_approve)

    behavior = sub.add_parser("behavior", help="behavior generate|rebuild|dry-run|report")
    behavior_sub = behavior.add_subparsers(dest="behavior_command", required=True)

    p = behavior_sub.add_parser("generate", help="incrementally generate behavior patterns")
    _add_root_args(p)
    p.set_defaults(func=cmd_behavior_generate, behavior_mode="incremental")

    p = behavior_sub.add_parser("rebuild", help="rebuild the full behavior generation from source")
    _add_root_args(p)
    p.set_defaults(func=cmd_behavior_generate, behavior_mode="rebuild")

    p = behavior_sub.add_parser("dry-run", help="print would-be behavior rows without writing")
    _add_root_args(p)
    p.add_argument(
        "--mode",
        choices=("incremental", "rebuild"),
        default="incremental",
        dest="behavior_mode",
    )
    p.set_defaults(func=cmd_behavior_dry_run)

    p = behavior_sub.add_parser("report", help="print a behavior report or summary as static JSON")
    _add_root_args(p)
    p.add_argument(
        "--format",
        choices=("timeline", "summary"),
        default="timeline",
        dest="report_format",
    )
    p.add_argument("--pattern-id", default=None)
    p.add_argument("--actor-key", default=None)
    p.add_argument("--edge-id", default=None)
    p.add_argument("--behavior-class", default=None)
    p.add_argument("--window-hours", type=int, default=168)
    p.add_argument("--limit", type=int, default=20)
    p.add_argument("--output", default=None)
    p.set_defaults(func=cmd_behavior_report)

    keys = sub.add_parser("keys", help="keys list|add|remove|set-role|set-threshold|unseal")
    keys_sub = keys.add_subparsers(dest="keys_command", required=True)

    p = keys_sub.add_parser("list")
    _add_root_args(p)
    p.set_defaults(func=cmd_keys_list)

    p = keys_sub.add_parser("add")
    _add_root_args(p)
    p.add_argument("key_id")
    p.add_argument("verify_key_hex")
    p.add_argument("--role", default=None, help="signer role for this key ([key_roles])")
    p.set_defaults(func=cmd_keys_add)

    p = keys_sub.add_parser("set-role")
    _add_root_args(p)
    p.add_argument("key_id")
    role = p.add_mutually_exclusive_group(required=True)
    role.add_argument("role", nargs="?", default=None)
    role.add_argument("--clear", action="store_true")
    p.set_defaults(func=cmd_keys_set_role)

    p = keys_sub.add_parser("unseal")
    _add_root_args(p)
    p.set_defaults(func=cmd_keys_unseal)

    p = keys_sub.add_parser("remove")
    _add_root_args(p)
    p.add_argument("key_id")
    p.add_argument("--revoke", action="store_true")
    p.set_defaults(func=cmd_keys_remove)

    p = keys_sub.add_parser("set-threshold")
    _add_root_args(p)
    p.add_argument("threshold", type=int)
    p.set_defaults(func=cmd_keys_set_threshold)

    client = sub.add_parser("client", help="client add|list|revoke")
    client_sub = client.add_subparsers(dest="client_command", required=True)

    p = client_sub.add_parser("add")
    _add_root_args(p)
    p.add_argument("--key-id", default=None)
    p.add_argument("--scopes", default="ingest,query")
    p.add_argument("--quota-bytes", type=int, default=None, dest="quota_bytes")
    p.set_defaults(func=cmd_client_add)

    p = client_sub.add_parser("list")
    _add_root_args(p)
    p.set_defaults(func=cmd_client_list)

    p = client_sub.add_parser("revoke")
    _add_root_args(p)
    p.add_argument("key_id")
    p.set_defaults(func=cmd_client_revoke)

    p = sub.add_parser("backup", help="VACUUM INTO both databases")
    _add_root_args(p)
    p.add_argument("--out-dir", required=True, dest="out_dir")
    p.set_defaults(func=cmd_backup)

    p = sub.add_parser("restore", help="restore both databases from a backup dir")
    _add_root_args(p)
    p.add_argument("--backup-dir", required=True, dest="backup_dir")
    p.add_argument("--confirm", action="store_true")
    p.set_defaults(func=cmd_restore)

    audit = sub.add_parser("audit", help="audit verify")
    audit_sub = audit.add_subparsers(dest="audit_command", required=True)
    p = audit_sub.add_parser("verify")
    _add_root_args(p)
    p.add_argument("--cross-check", action="store_true", help="reserved; chains+anchors are always cross-checked")
    p.set_defaults(func=cmd_audit_verify)

    p = sub.add_parser("health", help="print a health snapshot")
    _add_root_args(p)
    p.set_defaults(func=cmd_health)

    p = sub.add_parser("scrub", help="crypto-erase (documented stub in Phase 1)")
    p.add_argument("--force", action="store_true")
    p.set_defaults(func=cmd_scrub)

    return parser


def main(argv: list[str] | None = None) -> int:
    argv = list(argv) if argv is not None else sys.argv[1:]

    # `bundle build` is a pure passthrough to `tools/bundle_build.py build`.
    # Dispatched here, ahead of the main parser, because `argparse.REMAINDER`
    # does not reliably swallow a leading `--flag` token when it immediately
    # follows nested subparsers (a longstanding argparse quirk) -- forwarding
    # the raw argv avoids re-declaring bundle_build's own flags twice.
    if len(argv) >= 2 and argv[0] == "bundle" and argv[1] == "build":
        return bundle_build.main(["build", *argv[2:]])

    parser = build_parser()
    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
