[Unit]
Description=Azazel-Knowledge node (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=__ROOT_DIR__

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__REPO_DIR__
Environment=AZAZEL_ROOT=__ROOT_DIR__
ExecStart=__DOCKER__ compose -f __COMPOSE_FILE__ up -d
ExecStop=__DOCKER__ compose -f __COMPOSE_FILE__ down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
